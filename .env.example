# ============================================================================
# rag-app — variables d'environnement (copier en .env et adapter)
# ============================================================================

# --- Django -----------------------------------------------------------------
# Clé secrète Django (générer une valeur unique, jamais commitée).
DJANGO_SECRET_KEY=
# False en production.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines https://... de confiance en production (séparées par des virgules).
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- LLM (API compatible OpenAI) ---------------------------------------------
# En local : Ollama. En production : endpoint distant configurable.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.2

# --- Embeddings ---------------------------------------------------------------
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=nomic-embed-text
EMBED_BATCH_SIZE=32

# --- Vector store -------------------------------------------------------------
# `simple` (numpy, défaut) ou `chroma` (nécessite requirements-chroma.txt).
VECTOR_STORE=simple
VECTOR_STORE_PATH=data/index

# --- Chunking -----------------------------------------------------------------
# `fixed` ou `paragraph`.
CHUNKER_STRATEGY=fixed
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# --- Recherche / RAG ------------------------------------------------------------
TOP_K=4
MIN_SCORE=0.35
HISTORY_WINDOW=6
STREAMING_ENABLED=True
# `vector` ou `hybrid` (BM25 + vectoriel, phase 09).
RETRIEVER=vector

# --- Ingestion / uploads ----------------------------------------------------------
INDEX_ON_UPLOAD=True
MAX_UPLOAD_MB=10

# --- Divers -------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=30
DJANGO_LOG_LEVEL=INFO
# Développement front uniquement (phase 11) : URL du serveur Vite (npm run dev).
# Laisser vide en production : les assets construits sont servis depuis static/.
FRONTEND_DEV_URL=
# En mode npm run dev, ajouter aussi (le proxy Vite sert Django sur :8000) :
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
